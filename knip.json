{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["grype"],
  "workspaces": {
    ".": {
      "entry": ["stylelint.config.mjs", "integration/tests/e2e.mjs"],
      "project": ["**/*.{js,cjs,mjs,ts,cts,mts}", "!packages/**", "!.trunk/**", "!node_modules/**"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/runtime/api-server.js", "src/runtime/worker.js"],
      "project": ["src/**/*.{ts,js}"]
    }
  }
}
