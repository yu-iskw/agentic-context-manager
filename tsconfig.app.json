{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "types/**/*.d.ts",
    "apps/**/*.ts",
    "packages/contracts/**/*.ts",
    "packages/core/**/*.ts",
    "packages/db/**/*.ts",
    "packages/providers/**/*.ts"
  ]
}
